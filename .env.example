# ======================================
# Confluence Knowledge Agent - 환경 설정
# ======================================
# 이 파일을 .env로 복사하여 사용하세요: cp .env.example .env

# --- SSL 설정 ---
# 사내 자체 서명 인증서 사용 시 false로 설정
# SSL_VERIFY=false

# --- LLM 설정 ---
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:4b
LLM_BASE_URL=http://localhost:11434

# Anthropic API (Claude 사용 시)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Confluence 설정 ---
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your_api_token_here
# Auth type: basic (Atlassian Cloud, 기본값) / bearer (Server/DC Personal Access Token)
# CONFLUENCE_AUTH_TYPE=bearer
# CONFLUENCE_DEFAULT_SPACE=TEAM

# --- 검색 설정 ---
# SEARCH_PROVIDER=duckduckgo   # google, brave, duckduckgo (기본값)
# SEARCH_MAX_RESULTS=3
# SEARCH_PROXY=http://proxy.company.com:8080

# Google Custom Search (Optional)
# GOOGLE_SEARCH_API_KEY=your_google_api_key
# GOOGLE_SEARCH_CX_ID=your_custom_search_engine_id

# Brave Search API (Optional)
# BRAVE_API_KEY=your_brave_api_key

# --- MCP 서버 설정 ---
# Google Drive
# MCP_GDRIVE_ENABLED=true
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Microsoft SharePoint/OneDrive
# MCP_SHAREPOINT_ENABLED=true
# MICROSOFT_CLIENT_ID=your_client_id
# MICROSOFT_CLIENT_SECRET=your_client_secret
# MICROSOFT_TENANT_ID=your_tenant_id

# Notion
# MCP_NOTION_ENABLED=true
# NOTION_API_KEY=your_notion_api_key

# Slack
# MCP_SLACK_ENABLED=true
# SLACK_BOT_TOKEN=your_slack_bot_token

# --- 템플릿 설정 ---
# DEFAULT_TEMPLATE=summary
